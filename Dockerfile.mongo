FROM mongo:8.3.11@sha256:d731d77bfd7afd66bd487bdf627b5bf7ce4c3602ec461d635977021db529ebbc
# Use mongod + mongosh only. Backups copy a cleanly stopped data volume.
# Root switching, the old YAML config helper, and separate import/export tools
# are not needed by this deployment. Configure mongod using the provided args.
USER root
RUN apt-get purge -y mongodb-database-tools && \
    rm -rf /opt/js-yaml /js-yaml.js /usr/local/bin/gosu /var/lib/apt/lists/* && \
    command -v mongod && command -v mongosh && command -v tar
USER 999:999
