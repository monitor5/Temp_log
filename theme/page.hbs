{{!< default}}

{{#post}}
<article class="article {{post_class}}{{#unless @page.show_title_and_feature_image}} page-without-heading{{/unless}}">
    {{#match @page.show_title_and_feature_image}}
    <header class="article-header page-header wrap">
        <p class="eyebrow">{{@site.title}}</p>
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="article-summary">{{custom_excerpt}}</p>{{/if}}
    </header>
    {{> "feature-image"}}
    {{/match}}
    <div class="article-content gh-content">
        {{content}}
    </div>
    <footer class="article-footer">
        <a class="text-link" href="{{@site.url}}"><span aria-hidden="true">←</span> 모든 기록</a>
    </footer>
</article>
{{/post}}
