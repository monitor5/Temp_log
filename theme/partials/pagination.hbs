{{#if pages}}
<nav class="pagination" aria-label="기록 목록 페이지">
    <div class="pagination-previous">
        {{#if prev}}<a href="{{page_url prev}}" rel="prev"><span aria-hidden="true">←</span> 이전 페이지</a>{{/if}}
    </div>
    <span class="page-number" aria-label="{{pages}}페이지 중 {{page}}페이지">{{page}} <span aria-hidden="true">/</span> {{pages}}</span>
    <div class="pagination-next">
        {{#if next}}<a href="{{page_url next}}" rel="next">다음 페이지 <span aria-hidden="true">→</span></a>{{/if}}
    </div>
</nav>
{{/if}}
