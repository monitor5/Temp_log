<article class="post-card {{post_class}}{{#unless feature_image}} post-card-text{{/unless}}">
    {{#if feature_image}}
    <a class="card-image-link" href="{{url}}" tabindex="-1" aria-hidden="true">
        <img class="card-image"
             src="{{img_url feature_image size="medium"}}"
             srcset="{{img_url feature_image size="small"}} 400w, {{img_url feature_image size="medium"}} 800w, {{img_url feature_image size="large"}} 1400w"
             sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw"
             alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
             loading="lazy" decoding="async">
    </a>
    {{/if}}
    <div class="card-copy">
        <div class="card-kicker">
            {{#primary_tag}}<a class="tag-link" href="{{url}}">{{name}}</a>{{else}}<span>기록</span>{{/primary_tag}}
            {{#if featured}}<span class="featured-label">추천 기록</span>{{/if}}
        </div>
        <h3 class="card-title"><a href="{{url}}">{{title}}</a></h3>
        <p class="card-excerpt">{{excerpt characters="132"}}</p>
        <div class="card-meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY.MM.DD"}}</time>
            <span aria-hidden="true">·</span>
            <span>{{reading_time minute="약 1분" minutes="약 %분"}}</span>
            <span class="card-arrow" aria-hidden="true">↗</span>
        </div>
    </div>
</article>
