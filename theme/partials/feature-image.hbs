{{#if feature_image}}
<figure class="article-feature wrap">
    <img src="{{img_url feature_image size="large"}}"
         srcset="{{img_url feature_image size="medium"}} 800w, {{img_url feature_image size="large"}} 1400w, {{img_url feature_image size="full"}} 2200w"
         sizes="(min-width: 1248px) 1200px, 100vw"
         alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
         fetchpriority="high" decoding="async">
    {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
</figure>
{{/if}}
