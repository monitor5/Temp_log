<!DOCTYPE html>
<html lang="{{#if @site.locale}}{{@site.locale}}{{else}}ko{{/if}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{{meta_title}}</title>
    {{ghost_head}}
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
</head>
<body class="{{body_class}}">
    <a class="skip-link" href="#temp-log-main">본문으로 바로가기</a>
    <header class="site-header wrap">
        <a class="wordmark" href="{{@site.url}}" aria-label="{{@site.title}} 홈">
            <span class="wordmark-dot" aria-hidden="true"></span>
            {{@site.title}}
        </a>
        <nav class="primary-navigation" aria-label="주 메뉴">
            {{navigation}}
            <a class="rss-link" href="{{@site.url}}/rss/" aria-label="RSS 피드">RSS <span aria-hidden="true">↗</span></a>
        </nav>
    </header>
    <main id="temp-log-main" tabindex="-1">
        {{{body}}}
    </main>
    <footer class="site-footer wrap">
        <div>
            <a class="footer-title" href="{{@site.url}}">{{@site.title}}</a>
            <p>작은 기록들이 쌓이는 곳.</p>
        </div>
        <div class="footer-end">
            <p>© {{date format="YYYY"}} {{@site.title}} <span class="footer-divider" aria-hidden="true">/</span> <a href="{{@site.url}}/rss/">RSS 피드</a></p>
        </div>
    </footer>
    {{ghost_foot}}
</body>
</html>
