{{!< default}}

<div class="wrap">
    {{#author}}
    <header class="archive-header author-header">
        <div>
            <p class="eyebrow">기록하는 사람 / Author</p>
            <h1>{{name}}<span class="accent">.</span></h1>
            {{#if bio}}<p class="archive-description">{{bio}}</p>{{/if}}
            {{#if location}}<p class="author-location">{{location}}</p>{{/if}}
            <a class="text-link" href="{{@site.url}}"><span aria-hidden="true">←</span> 모든 기록</a>
        </div>
        {{#if profile_image}}<img class="author-image" src="{{img_url profile_image size="small"}}" alt="{{name}}" width="144" height="144">{{/if}}
    </header>
    {{/author}}
    <section class="entries" aria-label="작성자의 기록">
        <div class="post-grid">
            {{#foreach posts}}
                {{> "post-card"}}
            {{else}}
                <p class="empty-state">아직 공개된 기록이 없습니다.</p>
            {{/foreach}}
        </div>
        {{pagination}}
    </section>
</div>
